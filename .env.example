# Utsavly Environment Variables Template

# 1. Gemini GenAI Credentials
# If left empty, Utsavly automatically falls back to deterministic mock planning engines.
GEMINI_API_KEY=your_gemini_api_key_here

# 2. AI Mode Flag (true = mock deterministic engine, false = live Gemini API)
AI_MOCK=true

# 3. CORS Allowed Origins (comma-separated list of allowed frontend URLs)
# For local dev: http://localhost:5173,http://127.0.0.1:5173
# For production: https://your-utsavly-frontend.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 4. Frontend API Base URL
# Local dev: http://localhost:8000
# Production Render backend: https://utsavly-backend.onrender.com
VITE_API_URL=http://localhost:8000

# 5. Database Connection String (SQLite default)
DATABASE_URL=sqlite:///./utsavly.db
ENVIRONMENT=development
